# Copy each of these into Vercel → Project → Settings → Environment Variables.
# Never commit real values. .env.local (generated keys) is git-ignored.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=           # "anon" / "publishable" key — safe for the browser
SUPABASE_SERVICE_ROLE_KEY=   # "service_role" / "secret" key — server only, never share

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Generated for you in .env.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
